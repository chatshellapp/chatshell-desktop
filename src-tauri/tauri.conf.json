{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChatShell",
  "version": "0.9.1",
  "identifier": "app.chatshell.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ChatShell",
        "width": 1200,
        "height": 800,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "resources": ["resources/models_dev.json", "builtin-skills"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY1Qjc5MTYyNTg4M0QxMkYKUldRdjBZTllZcEczOVhFejJZZ1o1dTA2SE5zTE1aeWlBR3l2YmJjRjNqQlVpUTVIT2ZNZm8vaU4K",
      "endpoints": [
        "https://dl.chatshell.app/latest.json",
        "https://github.com/chatshellapp/chatshell-desktop/releases/latest/download/latest.json"
      ]
    }
  }
}
