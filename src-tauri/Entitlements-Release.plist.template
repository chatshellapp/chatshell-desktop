<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Release (Developer ID) entitlements. Every key here must be granted
	     by the Developer ID provisioning profile embedded at build time
	     (APPLE_PROVISIONING_PROFILE secret), otherwise macOS refuses to
	     launch the app. __TEAM_ID__ is injected by CI from APPLE_TEAM_ID;
	     the Team ID is deliberately not stored in this repo.
	     Differs from Entitlements-DevProfile.plist.template only by pinning
	     the iCloud container environment to Production, which is what the
	     Developer ID profile grants. -->
	<key>com.apple.application-identifier</key>
	<string>__TEAM_ID__.app.chatshell.desktop</string>
	<key>com.apple.developer.team-identifier</key>
	<string>__TEAM_ID__</string>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.app.chatshell</string>
	</array>
	<key>com.apple.developer.ubiquity-container-identifiers</key>
	<array>
		<string>iCloud.app.chatshell</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudDocuments</string>
	</array>
	<key>com.apple.developer.icloud-container-environment</key>
	<string>Production</string>
	<!-- Shared keychain group for the sync master encryption key
	     (team-prefixed; must match the iOS app and CHATSHELL_TEAM_ID). -->
	<key>keychain-access-groups</key>
	<array>
		<string>__TEAM_ID__.app.chatshell.sync</string>
	</array>
</dict>
</plist>
